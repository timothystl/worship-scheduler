{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timothy-finance-app-staging",
  "main": "apps/finance/shell.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "finance-staging.timothystl.org",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "FINANCE_DB",
      "database_name": "timothy-finance-db-staging",
      "database_id": "59dfc662-9f43-469f-936e-d7a0d3247036",
      "migrations_dir": "apps/finance/migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "RELEASE_SHA": "unreleased"
  },
  "observability": {
    "enabled": true
  }
}
