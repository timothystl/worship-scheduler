{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timothy-finance-app-staging",
  "main": "apps/finance/shell.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "finance-staging.timothystl.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "RELEASE_SHA": "unreleased"
  },
  "observability": {
    "enabled": true
  }
}
